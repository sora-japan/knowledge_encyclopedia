GEMINI_API_KEY=your-api-key-here
LLM_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=http://localhost:3000
EMBEDDING_MODEL=gemini-embedding-001
VECTOR_THRESHOLD=0.35
DAILY_REGISTER_LIMIT=30
DAILY_ASK_LIMIT=10
DAILY_EMBED_LIMIT=80
