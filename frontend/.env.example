# Next.js のサーバー側と rewrites プロキシが叩く FastAPI のURL
# NEXT_PUBLIC_ を付けない = ブラウザに配信されない
INTERNAL_API_BASE_URL=http://localhost:8000

# Supabase プロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase の publishable キー(sb_publishable_ 形式)。
# 公開前提のキーなので NEXT_PUBLIC_ で問題ない。
# secret キー(sb_secret_ / service_role)は絶対にここに入れない
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
